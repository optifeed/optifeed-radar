# Optifeed Radar - engine API keys (local only).
#
# Copy this file to `.env` and fill in at least one key. `.env` is gitignored,
# so your keys are never committed. Keys are never logged or persisted by the
# tool. `check` needs at least one; `audit` needs none.
#
#   cp .env.example .env    # then edit .env
#   npm run dev -- check yourbrand.com
#
# The CLI loads `.env` from the directory you run it in, so no shell setup is
# needed. A key already exported in your shell always wins over the one here.
# `optifeed-radar config` shows which keys were found and which file they came
# from (never the values).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
