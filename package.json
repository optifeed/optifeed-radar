{
  "name": "optifeed-radar",
  "version": "0.1.0",
  "description": "Open-source AI visibility checker (GEO/AEO). Is your brand recommended by ChatGPT, Perplexity, Gemini and Claude? BYO keys, runs locally.",
  "keywords": [
    "geo",
    "generative-engine-optimization",
    "ai-visibility",
    "answer-engine-optimization",
    "ai-shopping",
    "agentic-commerce",
    "mcp",
    "claude",
    "agent-skills",
    "openclaw-skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optifeed/optifeed-radar.git"
  },
  "bugs": {
    "url": "https://github.com/optifeed/optifeed-radar/issues"
  },
  "homepage": "https://github.com/optifeed/optifeed-radar#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "optifeed-radar": "dist/cli/index.js",
    "optifeed-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "METHODOLOGY.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.4"
  }
}
