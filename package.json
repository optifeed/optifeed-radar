{
  "name": "optifeed-visibility",
  "version": "0.0.0",
  "description": "Open-source AI visibility checker (GEO/AEO). Is your brand recommended by ChatGPT, Perplexity, Gemini and Claude? BYO keys, runs locally.",
  "keywords": [
    "geo",
    "generative-engine-optimization",
    "ai-visibility",
    "answer-engine-optimization",
    "ai-shopping",
    "agentic-commerce",
    "mcp",
    "claude",
    "agent-skills",
    "openclaw-skills"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "optifeed-visibility": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.4"
  }
}
